+void wxWebViewEdgeImpl::MoveFocusIn(COREWEBVIEW2_MOVE_FOCUS_REASON reason)
+{
+    if (!m_webViewController)
+        return;
+
+    // MoveFocus() is asynchronous: the web content takes the focus, and tells
+    // us that it did with GotFocus, or asks for the focus to be moved on with
+    // MoveFocusRequested, some time after the call below returns. Remember
+    // what we asked for until one of these two events happens, so that we can
+    // tell an answer to this call from a genuine request to leave the web view
+    // in OnMoveFocusRequested() without relying on the order or the timing of
+    // the events.
+    m_focusEnterReason = reason;
+    m_focusEnterRetried = false;
+
+    m_webViewController->MoveFocus(reason);
+}
+
+void wxWebViewEdgeImpl::MoveFocusOut(int flags)
+{
+    // Don't take the focus back into the web content if the traversal comes
+    // back to this control, e.g. because it's the only one accepting the focus
+    // in this window.
+    m_focusLeaving = true;
+
+    // wxWindow::Navigate() only asks our parent to continue the traversal and
+    // does nothing if the parent doesn't handle navigation itself, so keep
+    // asking the windows further up in this case, just as wxControlContainer
+    // does when it runs out of children of its own.
+    for (wxWindow* win = m_ctrl;
+         win && !win->IsTopNavigationDomain(wxWindow::Navigation_Tab);
+         win = win->GetParent())
+    {
+        if (win->Navigate(flags | wxNavigationKeyEvent::FromTab))
+            break;
+    }
+
+    m_focusLeaving = false;
+}
+
+HRESULT wxWebViewEdgeImpl::OnGotFocus(ICoreWebView2Controller* WXUNUSED(sender),
+    IUnknown* WXUNUSED(args))
+{
+    // The web content has taken the focus we asked it to take, so the next
+    // MoveFocusRequested will be a genuine request to leave the web view and
+    // not the answer to our own MoveFocus() call.
+    m_focusEnterReason = COREWEBVIEW2_MOVE_FOCUS_REASON_PROGRAMMATIC;
+
+    return S_OK;
+}
+
+HRESULT wxWebViewEdgeImpl::OnMoveFocusRequested(ICoreWebView2Controller* WXUNUSED(sender),
+    ICoreWebView2MoveFocusRequestedEventArgs* args)
+{
+    COREWEBVIEW2_MOVE_FOCUS_REASON reason;
+    if (FAILED(args->get_Reason(&reason)))
+        return S_OK;
+
+    // Whether it is a genuine request or the answer to our own MoveFocus(),
+    // this event ends the wait started by MoveFocusIn(): the pending state is
+    // always cleared by an event and never after a delay, so that a request
+    // arriving later than expected is still handled normally.
+    const COREWEBVIEW2_MOVE_FOCUS_REASON enterReason = m_focusEnterReason;
+    m_focusEnterReason = COREWEBVIEW2_MOVE_FOCUS_REASON_PROGRAMMATIC;
+
+    // The focus is still in the web content while this event is handled, so if
+    // it isn't here any more the request is stale, e.g. because the user has
+    // clicked somewhere else in the meanwhile, and moving the focus now would
+    // take it away from another window. Note that HasFocus() is true while the
+    // web content has it as the windows used by WebView2 are children of this
+    // control.
+    if (!m_ctrl->HasFocus())
+        return S_OK;
+
+    if (enterReason != COREWEBVIEW2_MOVE_FOCUS_REASON_PROGRAMMATIC)
+    {
+        // This is the answer to the MoveFocus() done when the focus arrived:
+        // the web content doesn't have any element to give the focus to in
+        // this direction.
+        if (!m_focusEnterRetried)
+        {
+            // Not all pages accept the focus when they're asked to start at
+            // their first or last focusable element, but they do accept it
+            // when asked for it without a direction, which puts the focus on
+            // the element which had it last or on the default one. Ask once
+            // more like this, so that the focus at least ends up inside the
+            // page instead of skipping it entirely, and only give up if this
+            // is refused too, which is what an empty page does.
+            m_focusEnterRetried = true;
+            m_focusEnterReason = enterReason;
+            m_webViewController->MoveFocus(COREWEBVIEW2_MOVE_FOCUS_REASON_PROGRAMMATIC);
+
+            args->put_Handled(TRUE);
+            return S_OK;
+        }
+
+        // There is really nothing to focus in the page, so carry on in the
+        // direction the traversal was going in when it arrived here. We can't
+        // use the direction of the event itself for this: a page refusing the
+        // focus asks for it to be moved back where it came from, which would
+        // make the focus bounce between this control and its neighbour.
+        reason = enterReason;
+    }
+    else if (reason == COREWEBVIEW2_MOVE_FOCUS_REASON_PROGRAMMATIC)
+    {
+        // Not a request to leave the web view in a given direction, and not an
+        // answer to one of our own requests either, so there is nothing to do.
+        return S_OK;
+    }
+
+    // The user has tabbed past the last (or before the first) focusable
+    // element of the page, so continue the keyboard traversal in the window
+    // containing this control, i.e. let the focus leave the web view instead
+    // of cycling inside it forever.
+    MoveFocusOut(reason == COREWEBVIEW2_MOVE_FOCUS_REASON_NEXT
+                    ? wxNavigationKeyEvent::IsForward
+                    : wxNavigationKeyEvent::IsBackward);
+
+    // Claim the request as handled even if we didn't find any other window to
+    // give the focus to: the default action is to look for the next tab stop
+    // among the native child windows of the application, which knows nothing
+    // about the order in which wxWidgets navigates its windows, and to cycle
+    // the focus inside the page if it doesn't find one, trapping the user in
+    // the web content.
+    args->put_Handled(TRUE);
+
+    return S_OK;
+}
