+
 void wxWebViewEdge::OnSetFocus(wxFocusEvent& event)
 {
-    if (m_impl && m_impl->m_webViewController)
-        m_impl->m_webViewController->MoveFocus(COREWEBVIEW2_MOVE_FOCUS_REASON_PROGRAMMATIC);
+    // Don't send the focus back to the web content while we're in the middle
+    // of moving it out of it, as this would loop forever if this control is
+    // the only one taking part in the traversal.
+    if (m_impl && !m_impl->m_focusLeaving)
+        m_impl->MoveFocusIn(GetMoveFocusReason());
+
     event.Skip();
 }
 
