+HRESULT wxWebViewEdgeImpl::OnMoveFocusRequested(ICoreWebView2Controller* WXUNUSED(sender),
+    ICoreWebView2MoveFocusRequestedEventArgs* args)
+{
+    COREWEBVIEW2_MOVE_FOCUS_REASON reason;
+    if (FAILED(args->get_Reason(&reason)))
+        return S_OK;
+
+    // The web content ran out of focusable elements in this direction, so
+    // continue the keyboard traversal in the window containing this control,
+    // i.e. let the focus leave the web view instead of cycling inside it.
+    //
+    // Don't do this while we're moving the focus into the web content
+    // ourselves from OnSetFocus(): a page without any focusable elements at
+    // all asks for the focus to move on immediately and sending it back to
+    // the parent could bounce it right back here.
+    if (!m_movingFocusIn &&
+        (reason == COREWEBVIEW2_MOVE_FOCUS_REASON_NEXT ||
+         reason == COREWEBVIEW2_MOVE_FOCUS_REASON_PREVIOUS))
+    {
+        const int dir = reason == COREWEBVIEW2_MOVE_FOCUS_REASON_NEXT
+                            ? wxNavigationKeyEvent::IsForward
+                            : wxNavigationKeyEvent::IsBackward;
+        if (m_ctrl->Navigate(dir | wxNavigationKeyEvent::FromTab))
+            args->put_Handled(TRUE);
+    }
+
+    return S_OK;
+}
