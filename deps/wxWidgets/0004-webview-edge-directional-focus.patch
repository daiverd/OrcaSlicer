+namespace
+{
+
+// Return the reason to pass to ICoreWebView2Controller::MoveFocus() when this
+// control gets the focus.
+//
+// If the focus arrives while Tab is pressed, it comes from the keyboard
+// traversal of the containing window and we ask WebView2 to put the DOM focus
+// on the first (or, when going backwards, the last) focusable element of the
+// page instead of just focusing the web content window, which would leave the
+// user with nothing to Tab from.
+//
+// We have to look at the key state because the focus event itself doesn't
+// carry the direction of the traversal and neither does SetFocusFromKbd(),
+// which isn't called at all when the focus is moved by the native dialog
+// navigation code.
+COREWEBVIEW2_MOVE_FOCUS_REASON GetMoveFocusReason()
+{
+    if (!wxGetKeyState(WXK_TAB))
+        return COREWEBVIEW2_MOVE_FOCUS_REASON_PROGRAMMATIC;
+
+    return wxGetKeyState(WXK_SHIFT) ? COREWEBVIEW2_MOVE_FOCUS_REASON_PREVIOUS
+                                    : COREWEBVIEW2_MOVE_FOCUS_REASON_NEXT;
+}
+
+} // anonymous namespace
+
 void wxWebViewEdge::OnSetFocus(wxFocusEvent& event)
 {
     if (m_impl && m_impl->m_webViewController)
-        m_impl->m_webViewController->MoveFocus(COREWEBVIEW2_MOVE_FOCUS_REASON_PROGRAMMATIC);
+    {
+        m_impl->m_movingFocusIn = true;
+        m_impl->m_webViewController->MoveFocus(GetMoveFocusReason());
+        m_impl->m_movingFocusIn = false;
+    }
     event.Skip();
 }
 
