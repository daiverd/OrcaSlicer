 // wxDataViewCtrlAccessible
 //-----------------------------------------------------------------------------
 
+// Note that this object is associated with the main window of the control and
+// not the control itself because the main window is the one which has the
+// keyboard focus and to which the mouse events are sent, so this is the window
+// the accessibility clients look at.
 class WXDLLIMPEXP_CORE wxDataViewCtrlAccessible: public wxWindowAccessible
 {
 public:
-    wxDataViewCtrlAccessible(wxDataViewCtrl* win);
+    wxDataViewCtrlAccessible(wxDataViewMainWindow* win);
     virtual ~wxDataViewCtrlAccessible() = default;
 
     virtual wxAccStatus HitTest(const wxPoint& pt, int* childId,
@@ -476,6 +476,11 @@ public:
     virtual wxAccStatus GetFocus(int* childId, wxAccessible** child) override;
 
     virtual wxAccStatus GetSelections(wxVariant* selections) override;
+
+private:
+    // Return the control this accessible object provides information about or
+    // nullptr if it can't be determined (which shouldn't normally happen).
+    wxDataViewCtrl* GetCtrl();
 };
 #endif // wxUSE_ACCESSIBILITY
 
