diff --git a/src/msw/ole/access.cpp b/src/msw/ole/access.cpp
index d2e9f9b..189f4c4 100644
--- a/src/msw/ole/access.cpp
+++ b/src/msw/ole/access.cpp
@@ -169,7 +169,10 @@ STDMETHODIMP wxIEnumVARIANT::Clone(IEnumVARIANT **ppenum)
 // wxIAccessible implementation of IAccessible interface
 // ----------------------------------------------------------------------------
 
-class wxIAccessible : public IAccessible
+// IOleWindow is implemented too so that WindowFromAccessibleObject() can
+// find the window of this object directly instead of walking up the parent
+// chain until it reaches an object that does implement it.
+class wxIAccessible : public IAccessible, public IOleWindow
 {
 public:
     wxIAccessible(wxAccessible *pAccessible);
@@ -313,6 +316,16 @@ public:
                         VARIANT *pVarResult, EXCEPINFO *pExcepInfo,
                         unsigned int *puArgErr ) override;
 
+// IOleWindow
+
+        // Retrieves the handle of the window this object belongs to.
+
+    STDMETHODIMP GetWindow(HWND* phwnd) override;
+
+        // Context-sensitive help mode is not supported.
+
+    STDMETHODIMP ContextSensitiveHelp(BOOL fEnterMode) override;
+
 // Helpers
 
     // Gets the standard IAccessible interface for the given child or object.
@@ -343,7 +356,54 @@ BEGIN_IID_TABLE(wxIAccessible)
   ADD_IID(Dispatch)
 END_IID_TABLE;
 
-IMPLEMENT_IUNKNOWN_METHODS(wxIAccessible)
+// Not IMPLEMENT_IUNKNOWN_METHODS() because the object has two base
+// interfaces, so QueryInterface() must return a pointer to the subobject of
+// the requested one, while the generic macro always returns "this": IUnknown,
+// IDispatch and IAccessible all resolve to the IAccessible subobject,
+// IOleWindow to the other one.
+STDMETHODIMP wxIAccessible::QueryInterface(REFIID riid, void **ppv)
+{
+    wxLogQueryInterface(wxT("wxIAccessible"), riid);
+
+    if ( IsIidFromList(riid, ms_aIids, WXSIZEOF(ms_aIids)) )
+    {
+        *ppv = static_cast<IAccessible*>(this);
+    }
+    else if ( riid == IID_IOleWindow )
+    {
+        *ppv = static_cast<IOleWindow*>(this);
+    }
+    else
+    {
+        *ppv = nullptr;
+        return (HRESULT) E_NOINTERFACE;
+    }
+
+    AddRef();
+    return S_OK;
+}
+
+STDMETHODIMP_(ULONG) wxIAccessible::AddRef()
+{
+    wxLogAddRef(wxT("wxIAccessible"), m_cRef);
+
+    return ++m_cRef;
+}
+
+STDMETHODIMP_(ULONG) wxIAccessible::Release()
+{
+    wxLogRelease(wxT("wxIAccessible"), m_cRef);
+
+    if ( --m_cRef == wxAutoULong(0) )
+    {
+        delete this;
+        return 0;
+    }
+    else
+    {
+        return m_cRef;
+    }
+}
 
 wxIAccessible::wxIAccessible(wxAccessible *pAccessible)
 {
@@ -361,6 +421,34 @@ void wxIAccessible::Quiesce()
     m_pAccessible = nullptr;
 }
 
+// Retrieves the handle of the window this object belongs to.
+
+STDMETHODIMP wxIAccessible::GetWindow(HWND* phwnd)
+{
+    wxLogTrace(wxT("access"), wxT("GetWindow"));
+    wxASSERT( ( m_pAccessible != nullptr ) || ( m_bQuiescing == true ) );
+    if (!phwnd)
+        return E_INVALIDARG;
+
+    *phwnd = nullptr;
+    if (!m_pAccessible)
+        return E_FAIL;
+
+    wxWindow* const window = m_pAccessible->GetWindow();
+    if (!window || !window->GetHWND())
+        return E_FAIL;
+
+    *phwnd = (HWND) window->GetHWND();
+    return S_OK;
+}
+
+// Context-sensitive help mode is not supported.
+
+STDMETHODIMP wxIAccessible::ContextSensitiveHelp(BOOL WXUNUSED(fEnterMode))
+{
+    return E_NOTIMPL;
+}
+
 // Retrieves the child element or child object at a given point on the screen.
 // All visual objects support this method; sound objects do not support it.
 
