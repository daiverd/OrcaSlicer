-                    if ( node->IsOpen() )
-                        /* TRANSLATORS: Keystroke for manipulating a tree control */
-                        *shortcut = _("Left");
-                    else
-                        /* TRANSLATORS: Keystroke for manipulating a tree control */
-                        *shortcut = _("Right");
-
-                    return wxACC_OK;
-                }
-            }
-        }
-    }
-
+wxAccStatus
+wxDataViewCtrlAccessible::GetKeyboardShortcut(int WXUNUSED(childId),
+                                              wxString* WXUNUSED(shortcut))
+{
+    // This slot is meant for a real accelerator, e.g. "ALT+K", and screen
